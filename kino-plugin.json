{
  "id": "catalogo-net",
  "name": "CATALOG//NET",
  "version": "1.0.6",
  "apiVersion": 8,
  "entry": "plugin.js",
  "description": "Catálogo masivo de películas y series extraído de Movie Plus.",
  "author": "Susejing",
  "homepage": "https://github.com/Susejing/catalogo-net",
  "hosts": [
    "raw.githubusercontent.com",
    "victory-incl-elephant-diesel.trycloudflare.com",
    "api.themoviedb.org",
    "*.yandex.net",
    "*.yandex.ru",
    "yadi.sk"
  ],
  "capabilities": [
    "home",
    "search",
    "browse",
    "resolve"
  ],
  "streamHosts": "any",
  "color": "#2C3E50",
  "icon": "icon.png",
  "settings": [
    {
      "key": "tmdb_api_key",
      "label": "API Key de TMDB (para sinopsis)",
      "type": "text",
      "hint": "Pega aquí tu clave de themoviedb.org"
    }
  ]
}
